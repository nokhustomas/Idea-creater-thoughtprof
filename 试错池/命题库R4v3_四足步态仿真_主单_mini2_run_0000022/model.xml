          <joint name="RR_knee" type="hinge" axis="0 1 0" range="-1.4 0.0" pos="0 0 0"/>
          <inertial pos="0 0 -0.06" mass="0.3" diaginertia="0.004 0.004 0.002"/>
          <geom name="RR_shank_geom" type="box" size="0.12 0.02 0.02" mass="0.3" fromto="0 0 0 0 0 -0.12" rgba="0.8 0.8 0.2 1" contype="1" conaffinity="1"/>
          <site name="RR_foot" pos="0 0 -0.12" type="sphere" size="0.015" rgba="0.9 0.9 0.9 1"/>
        </body>
      </body>
    </body>
  </worldbody>
  <actuator>
    <motor name="FL_motor" joint="FL_hip"/>
    <motor name="FR_motor" joint="FR_hip"/>
    <motor name="RL_motor" joint="RL_hip"/>
    <motor name="RR_motor" joint="RR_hip"/>
    <motor name="FL_knee_motor" joint="FL_knee"/>
    <motor name="FR_knee_motor" joint="FR_knee"/>
    <motor name="RL_knee_motor" joint="RL_knee"/>
    <motor name="RR_knee_motor" joint="RR_knee"/>
  </actuator>
</mujoco>